<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- 1. बाहर दिखने वाली मुख्य नोट्स स्क्रीन (भेष) -->
    <LinearLayout
        android:id="@+id/layoutNotesView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ऐप का टाइटल -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Notes"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"/>

        <!-- सीक्रेट सर्च बार (कीबोर्ड हिस्ट्री पूरी तरह बंद) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="2dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="18sp"
                    android:layout_marginEnd="10dp"/>

                <EditText
                    android:id="@+id/searchBarNotes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Search notes..."
                    android:textColor="#202124"
                    android:textColorHint="#9AA0A6"
                    android:textSize="15sp"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- नोट्स की लिस्ट -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/containerNotesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- नोट्स कोड के ज़रिए यहाँ अपने आप जुड़ेंगे -->
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 2. नया नोट जोड़ने वाला गोल बटन (+) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        app:tint="#FFFFFF"
        app:backgroundTint="#6750A4"
        android:contentDescription="Add Note"
        app:srcCompat="@android:drawable/ic_input_add"/>

    <!-- 3. सीक्रेट वॉल्ट (जादुई कंटेनर - सामान्य रूप से छुपा हुआ) -->
    <FrameLayout
        android:id="@+id/layoutSecretVault"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#0D0C18">

        <WebView
            android:id="@+id/vaultWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- तुरंत बाहर आने का इमरजेंसी लॉक बटन (Top-Right) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickLock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Lock"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#80000000"
            app:cornerRadius="20dp"
            android:layout_gravity="top|end"
            android:layout_margin="14dp"/>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
